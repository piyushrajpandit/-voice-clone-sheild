# Voice Clone Shield - Twilio SMS & Notification Settings
# Copy this file to .env and fill in your Twilio credentials

# Your Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Your Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio verified Sender Phone Number (E.164 format, e.g. +12345678900)
TWILIO_PHONE_NUMBER=+12345678900

# Emergency Guardian / Family Alert Phone Number to receive automated warnings (E.164 format, e.g. +19876543210 or +919876543210)
EMERGENCY_CONTACT_PHONE=+19876543210

# Master toggle for SMS alerting (true/false)
SMS_ALERTS_ENABLED=true
